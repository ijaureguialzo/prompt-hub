# Local development environment for the API server.
# Copy and adjust:  cp .env.example .env  &&  npm run dev

# MongoDB connection (local Docker DB from the root docker-compose, or Atlas, etc.)
MONGO_URI=mongodb://localhost:27017/promptdb

PORT=3000

# REQUIRED — the server refuses to start without it (fail-fast).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRES_IN=1h

# Optional rate-limit tuning (per client IP, per 15 min window):
# RATE_LIMIT_AUTH=10        # login attempts
# RATE_LIMIT_REGISTER=5     # public signups
# RATE_LIMIT_API=300        # all other API traffic

# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
