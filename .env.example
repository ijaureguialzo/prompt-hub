# Node.js version used in server and client Dockerfiles (node:<version>-slim)
NODE_VERSION=26-slim

# MongoDB version used in docker-compose.yml (mongo:<version>)
MONGO_VERSION=8

# MongoDB credentials and database name
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=change_me_password
MONGO_DB=promptdb

# Public hostnames for Traefik routing. docker-compose falls back to these
# same values when the vars are unset (prompthub.test / api.prompthub.test).
# If you change FQDN_API (or the base domain), also update the API origin in
# the CSP in traefik/headers.yml — otherwise the edge CSP blocks the SPA's
# cross-origin API calls.
FQDN_FRONTEND=prompthub.test
FQDN_API=api.prompthub.test

# Frontend API URL (baked into the SPA at build time).
# MUST point at the API host, never the frontend host: pointing it at the
# frontend host made Traefik serve the SPA's index.html (HTTP 200) for
# /api/*, so the login "worked" and the app came up silently empty.
VITE_API_URL=https://api.prompthub.test/api

# CORS allowed origins (comma-separated; default: https://prompthub.test).
# Needed while VITE_API_URL is cross-origin (the default above): list the SPA
# origin. Traefik also routes the frontend host's /api/ prefix to the API
# service, so a same-origin client (VITE_API_URL=/api) bypasses CORS entirely
# — with that option this var stays only as a safety net.
CORS_ORIGIN=https://prompthub.test

# REQUIRED: strong random secret (32+ chars). The API refuses to start
# without it. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Per-user content quotas (spam/DoS protection). Enforced on create.
MAX_PROMPTS_PER_USER=200
MAX_CATEGORIES_PER_USER=50

# Import tuning (SPEC §2.2a), optional — defaults shown
# MAX_IMPORT_PROMPTS=500    # max prompts accepted in one import request
# IMPORT_BODY_LIMIT=20mb    # JSON body limit for POST /api/prompts/import

# Rate limits per client IP (per 15 min window)
# RATE_LIMIT_AUTH=10        # login
# RATE_LIMIT_REGISTER=5     # register
# RATE_LIMIT_API=300        # whole API
# RATE_LIMIT_WRITE=20       # POST /api/prompts + POST /api/categories + POST /api/prompts/import
